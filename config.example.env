# Copy to config.env and edit. Every Slurm script sources it.
# config.env is gitignored so your site settings never land in a commit.

# ---- Slurm -------------------------------------------------------------------
OCR_ACCOUNT="myproject@h100"     # sbatch -A
OCR_PARTITION="gpu"              # sbatch --partition
OCR_QOS=""                       # sbatch --qos  (leave empty if your site has none)
OCR_CONSTRAINT=""                # sbatch -C     (e.g. h100; empty if unused)
OCR_TIME="20:00:00"              # walltime; the worker stops cleanly before it
OCR_CPUS=24                      # cpus per task — drives PDF rasterisation
OCR_GPUS=1                       # GPUs per worker; DotsOCR fits on one

# Modules to load before activating the venv. Leave empty if your site has none.
OCR_MODULES="cuda/12.8.0"

# ---- Paths -------------------------------------------------------------------
OCR_VENV="/path/to/dots_ocr_venv"     # the venv (see docs/INSTALL.md)
OCR_MODEL="/path/to/DotsOCR"          # weights + modeling code
OCR_CACHE_ROOT="/path/to/scratch"     # writable: HF, vLLM, triton caches

OCR_PDF_ROOT="/path/to/pdfs"          # input: a dir of PDFs, or a dir of dirs
OCR_RESULTS_ROOT="/path/to/results"   # output: <results>/<folder>/ocr_results/*.parquet
OCR_LOG_DIR="/path/to/logs"

# ---- Model knobs -------------------------------------------------------------
OCR_DPI=150                      # rasterisation DPI; bbox is in these pixels
OCR_BATCH_SIZE=100               # pages per batch
OCR_GPU_MEMORY=0.95              # vLLM gpu_memory_utilization
OCR_STATS=0                      # 1 writes a per-PDF stats sidecar (costs inodes)
